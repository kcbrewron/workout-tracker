{
	"name": "sveltekit-d1-tailwindcss-template",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest",
		"docs": "jsdoc -c jsdoc.config.json",
		"d1:create": "npx d1 create --name",
		"d1:migrate": "npx d1 apply migration --database your-database-name --env your-env-name",
		"lint": "eslint . --ext .js,.ts,.svelte",
		"lint:fix": "eslint . --ext .js,.ts,.svelte --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "npm run format:check && npm run lint && npm run test:run",
		"test:run": "vitest run"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.1",
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^3.0.0",
		"@testing-library/user-event": "^14.6.1",
		"@typescript-eslint/eslint-plugin": "^8.37.0",
		"@typescript-eslint/parser": "^8.37.0",
		"autoprefixer": "^10.4.14",
		"eslint": "^9.31.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-prettier": "^5.5.1",
		"eslint-plugin-svelte": "^3.10.1",
		"jsdoc": "^4.0.2",
		"jsdom": "^26.1.0",
		"postcss": "^8.4.24",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^4.0.0",
		"svelte-check": "^3.4.3",
		"svelte-eslint-parser": "^1.2.0",
		"tailwindcss": "^3.3.2",
		"vite": "^5.0.0",
		"vitest": "^1.0.0"
	},
	"type": "module",
	"dependencies": {
		"@playwright/test": "^1.54.1",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.8"
	},
	"packageManager": "yarn@4.9.2"
}
